# ------------------------------------------------------------------------------
# 1. DODO PAYMENTS (LIVE PRODUCTION KEYS)
# ------------------------------------------------------------------------------
# In app.dodopayments.com -> Toggle LIVE MODE -> Developer -> API Keys -> Create Key
DODO_PAYMENTS_API_KEY=live_your_actual_live_api_key_here
DODO_PAYMENTS_ENVIRONMENT=live_mode
NEXT_PUBLIC_DODO_ENVIRONMENT=live_mode

# In app.dodopayments.com -> Webhooks -> Add Endpoint -> URL: https://outbidking.lol/api/webhooks/dodo
# Subscribed Events: payment.succeeded, payment.failed, checkout.session.completed
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_actual_webhook_secret_here

